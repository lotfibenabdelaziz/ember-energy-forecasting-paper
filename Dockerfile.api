# Dockerfile.api — Ember Energy FastAPI Server
# Lightweight image — no torch, no jupyter

# ── Stage 1: builder ──────────────────────────────────────────────────────────
FROM python:3.10-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-docker.txt .

RUN pip install --upgrade pip \
 && pip install --prefix=/install --no-cache-dir \
    --retries 5 --timeout 120 \
    -r requirements-docker.txt

# ── Stage 2: runner ───────────────────────────────────────────────────────────
FROM python:3.10-slim AS runner

WORKDIR /app

COPY --from=builder /install /usr/local

# Copy API source only
COPY api/ ./api/

# outputs/ is mounted at runtime via Docker volumes — never baked into image
RUN mkdir -p \
    outputs/eda/figures \
    outputs/preprocessing/figures \
    outputs/modeling/figures \
    outputs/forecasting/figures \
    outputs/deeplearning/figures

RUN useradd -m -u 1000 ember \
 && chown -R ember:ember /app
USER ember

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PORT=8000 \
    ENV=production \
    OUTPUT_ROOT=outputs

EXPOSE 8000

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
