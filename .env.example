# .env.example — Ember Energy Forecasting
# Copy to .env and fill in real values. Never commit .env or k8s/secret.yaml.
#
# NOTE ON SOURCE OF TRUTH: pipeline parameters (countries, split years,
# model hyperparameters) live in params.yaml, which src/config.py reads.
# The variables below are runtime/deployment/secret config only — things
# that legitimately differ per environment and should NOT be duplicated
# into params.yaml.

# ── Data ──────────────────────────────────────────────────────────────────────
CSV_PATH=data/raw/yearly_full_release_long_format.csv

# ── Outputs ───────────────────────────────────────────────────────────────────
OUTPUT_ROOT=outputs
OUTPUTS_DIR=outputs

# ── Environment ───────────────────────────────────────────────────────────────
ENV=development
PORT=8000

# ── MLflow ────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000

# ── API auth (change before any non-local use — see api/auth.py) ─────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-deploying
SECRET_KEY=generate-a-real-random-value-do-not-reuse-this-one
TOKEN_EXPIRE_MINUTES=60
DASHBOARD_API_KEY=

# ── API hardening ─────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ── Optional: LangChain /ask endpoint ─────────────────────────────────────────
OPENAI_API_KEY=

# ── Deep learning (defaults live in params.yaml; override here only for
#    a specific local run, e.g. a quick smoke test) ───────────────────────────
# SEQ_LEN=5
# EPOCHS=300
# PATIENCE=40
# BATCH_SIZE=16
# LR=0.001
# SEED=42
