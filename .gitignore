# =============================================================================
# .gitignore — Ember Energy Forecasting
# =============================================================================

# ── Secrets (NEVER commit) ────────────────────────────────────────────────────
.env
k8s/secret.yaml

# ── Data (large files — tracked by DVC) ──────────────────────────────────────
data/raw/*.csv
data/raw/*.parquet
data/raw/*.feather
data/processed/
data/engineering/
data/externel/
yearly_full_release_long_format.csv

# Keep DVC pointer files
!data/raw/*.dvc
!data/**/.gitignore

# ── Pipeline outputs (auto-generated) ────────────────────────────────────────
outputs/
mlruns/
.cache/
warehouse/*.db
warehouse/*.duckdb
htmlcov/
coverage.xml
.coveragerc.bak

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg
pip-log.txt
pip-delete-this-directory.txt

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
notebooks/

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.conda/

# ── DVC runtime (keep config, ignore cache) ───────────────────────────────────
.dvc/tmp/
.dvc/cache/

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.swn

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Matplotlib cache ─────────────────────────────────────────────────────────
.matplotlib_cache/

# ── LaTeX ─────────────────────────────────────────────────────────────────────
*.aux
*.fls
*.fdb_latexmk
*.synctex.gz

# ── Docker ────────────────────────────────────────────────────────────────────
.dockerignore.bak

# ── Testing ───────────────────────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/"" 
.mplconfig/" 

.coverage
coverage.xml
mlflow.db
.mplconfig/
warehouse/
data/engineering/df_engineering.csv
data/processed/df_wide_processed.csv
outputs_comparison/