[run]
source = src, api, pipeline, mlflow_config, pipeline_cache
omit =
    */tests/*
    */conftest.py
    */__pycache__/*
    */node_modules/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise NotImplementedError
    if __name__ == .__main__.:
    pass
fail_under = 60
show_missing = True

[html]
directory = htmlcov
